{
  "name": "Kess Cloud",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "containerEnv": {
    "TRUST_PROXY": "1",
    "MONITOR": "0"
  },
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": { "label": "Kess Cloud", "onAutoForward": "openBrowser" }
  },
  "postAttachCommand": {
    "kess-cloud": "npm run dev"
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
