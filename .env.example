# Used by deploy/ (Caddy): the address of Kess Cloud and the email for certificate notices
KESS_DOMAIN=cloud.kess.media
ACME_EMAIL=alex@kess.media

# Port the app listens on
PORT=8787
# Where the SQLite database and uploaded files live (mount a persistent volume here)
DB_FILE=./data/kess-cloud.db
DATA_DIR=./data
# Public URL of this Kess Cloud (used in links, forms and analytics of exported sites)
PUBLIC_URL=https://cloud.kess.media
# First owner account, created on first start if no owner exists
KESS_OWNER_EMAIL=alex@kess.media
KESS_OWNER_PASSWORD=
# Set to 1 behind a proxy/load balancer so client IPs and https are detected
TRUST_PROXY=1
# Uptime monitoring (0 to disable) and interval in minutes
MONITOR=1
MONITOR_INTERVAL_MIN=5
# Load demo clients, sites, invoices (development only)
DEMO=0

# --- Email (notifications, invites, password resets, reminders, monthly reports) ---
# resend or postmark. Leave empty to only record emails in Settings > Email outbox.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=Kess Media <hello@kess.media>
# Domains verified with the provider. Staff whose "send as" address is on one of these
# send from their own address (e.g. georgia@kess.media). Others send from MAIL_FROM with their name and reply-to.
MAIL_VERIFIED_DOMAINS=kess.media

# --- Card payments on invoices (Stripe Checkout) ---
# Webhook URL to add in Stripe: <PUBLIC_URL>/api/public/stripe/webhook (event: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Backups (nightly, database + uploaded files) ---
BACKUPS=1
BACKUP_KEEP=14
# Optional off-site copy to any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto

# Daily jobs: backups, overdue reminders, monthly client reports (0 to disable)
JOBS=1

# --- Socials (daily posts for Kess Gallery, Kess Media and Alex Kess; moved over from kess-socials) ---
# SAFETY: leave both at 0 while the Vercel app is live. Only one app may send to Publer and run the daily jobs.
# 1 = really send to Publer. Anything else = dry run (the exact Publer request is built and kept on the card).
SOCIALS_SEND=0
# 1 = nightly sync (20:00), daily suggest (07:00) and caption top-up (07:20), Sydney time.
SOCIALS_JOBS=0
# 1 = also email the owner "Today's socials are ready" (it is always in the app's notifications)
SOCIALS_NOTIFY_EMAIL=0
# Claude writes the captions. Model defaults to claude-sonnet-5-5.
ANTHROPIC_API_KEY=
SOCIALS_CAPTION_MODEL=
# Only for organisation-level keys that are not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# 0 = do not ask the API to re-run a declined caption on a fallback model
SOCIALS_CAPTION_FALLBACKS=1
# Publer (same values as on Vercel)
PUBLER_API_KEY=
PUBLER_WORKSPACE_ID=
# Shopify custom app for Kess Gallery (Dev Dashboard, client credentials)
SHOPIFY_STORE=alex-kess-photography.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only for scripts/import-socials-from-supabase.mjs (read only), not for the server
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Connected apps (see docs/INTEGRATIONS.md) ---
# Encryption key for stored app tokens (optional; a key file in DATA_DIR is created otherwise)
KESS_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# XERO_SCOPES=  only for Xero apps created before March 2026
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
VIMEO_TOKEN=
