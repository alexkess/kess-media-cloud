# Port the app listens on
PORT=8787
# Where the SQLite database and uploaded files live (mount a persistent volume here)
DB_FILE=./data/kess-cloud.db
DATA_DIR=./data
# Public URL of this Kess Cloud (used in links, forms and analytics of exported sites)
PUBLIC_URL=https://cloud.kess.media
# First owner account, created on first start if no owner exists
KESS_OWNER_EMAIL=alex@kess.media
KESS_OWNER_PASSWORD=
# Set to 1 behind a proxy/load balancer so client IPs and https are detected
TRUST_PROXY=1
# Uptime monitoring (0 to disable) and interval in minutes
MONITOR=1
MONITOR_INTERVAL_MIN=5
# Load demo clients, sites, invoices (development only)
DEMO=0
